# Exceeds GitHub LFS 2 GB per-file limit (~12 GB locally)
pics.zip
material/pics.zip

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# Local caches / intermediates (artifacts go under artifacts/ and are selectively LFS-pushed)
.cache/
*.tmp
*.partial

# Per-user hidden states (~900 MB) stay local: they are regenerable from the
# committed corpora + configs, and would blow past the GitHub LFS quota.
# Everything needed to re-run the LLM stage (posts, cohort, captions, corpora) is
# committed via LFS.
artifacts/full/reps/**/*.npz
artifacts/captions/*/shards/

# IDE
.idea/
.vscode/
